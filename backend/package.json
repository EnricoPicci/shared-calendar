{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "SAM_CLI_BETA_NODEJS_MONOREPO=1 sam build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "audit": "npm audit --audit-level=high",
    "test:unit": "vitest run --project unit --coverage",
    "test:integration": "vitest run --project integration",
    "local:up": "mkdir -p .cognito && cp docker/cognito-local-config.json .cognito/config.json && docker compose up -d && bash scripts/local-seed.sh",
    "local:down": "docker compose down",
    "local:api": "bash scripts/local-api.sh",
    "verify": "bash scripts/verify.sh",
    "deploy": "bash scripts/deploy.sh",
    "bootstrap-admin": "bash scripts/bootstrap-admin.sh",
    "smoke": "bash scripts/smoke.sh",
    "budget": "bash scripts/budget.sh"
  },
  "dependencies": {
    "@shared-calendar/shared": "*",
    "@aws-sdk/client-cognito-identity-provider": "^3.1158.0",
    "@aws-sdk/client-dynamodb": "^3.1158.0",
    "@aws-sdk/lib-dynamodb": "^3.1158.0",
    "aws-jwt-verify": "^5.2.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.164",
    "aws-sdk-client-mock": "^4.1.0"
  }
}
