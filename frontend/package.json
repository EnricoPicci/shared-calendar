{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run --project unit --project views --coverage",
    "test:integration": "vitest run --project integration",
    "verify": "npm run typecheck && npm run lint && npm run test:unit"
  },
  "dependencies": {
    "@shared-calendar/shared": "*",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4"
  }
}
