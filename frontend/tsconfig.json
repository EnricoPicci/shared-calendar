{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // DOM for fetch, Response, atob and the views' elements; DOM.Iterable so that FormData and the
    // lists of elements can be looped over. No "node": nothing in frontend/src may use Node APIs.
    // (The integration test reads env.local.json with node:fs and carries its own declaration.)
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
