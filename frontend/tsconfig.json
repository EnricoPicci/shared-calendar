{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // DOM for fetch, Response, atob. No "node": nothing in frontend/ may use Node APIs.
    // (The integration test reads env.local.json with node:fs and carries its own declaration.)
    "lib": ["ES2022", "DOM"],
    "types": ["vitest/globals"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "*.config.ts"]
}
